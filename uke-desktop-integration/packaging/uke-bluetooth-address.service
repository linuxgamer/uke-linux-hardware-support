[Unit]
Description=Admit the Uke Bluetooth factory address
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionPathExists=/mnt/vendor/persist/bluetooth/.bt_nv.bin
RequiresMountsFor=/mnt/vendor/persist
BindsTo=sys-subsystem-bluetooth-devices-hci0.device
After=sys-subsystem-bluetooth-devices-hci0.device

[Service]
Type=oneshot
ExecStart=/usr/libexec/uke-bluetooth-address
TimeoutStartSec=35
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The helper only stats this node to verify the mounted factory partition.
BindReadOnlyPaths=/dev/disk/by-partlabel/persist
ReadOnlyPaths=/mnt/vendor/persist
NoNewPrivileges=yes
# Android owns the private directory; bypass read permissions without write access.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_BLUETOOTH

[Install]
WantedBy=bluetooth.target
