#!/bin/bash
# Only invoked by an approved native build, never by source preparation.
set -euo pipefail
if [[ " ${DEB_BUILD_PROFILES:-} " == *" pkg.uke-linux-kernel.artifact-trial "* || " ${DEB_BUILD_PROFILES:-} " == *" pkg.uke-linux-kernel.verified-cohort "* ]]; then
 echo 'Unsupported: artifact-trial packaging cannot invoke the kernel source producer.' >&2
 exit 78
fi
if [[ ${1:-} == build || ${1:-} == boot ]]; then
 [[ ${UKE_KERNEL_DISTRO:-} == ubuntu ]] || { echo 'Unsupported: explicit UKE_KERNEL_DISTRO=ubuntu is required for this Debian producer.' >&2; exit 78; }
fi
export LC_ALL=C ARCH=arm64 LLVM=1 LLVM_IAS=1
root=$PWD
kernel=$root/build/linux-7.3.1
output=$root/build/output/ubuntu
release=7.3.1-1006u2
localversion=-1006u2
# Shared ALSA driver IDs contain "uke" plus UTS_RELEASE and a terminating NUL.
# Keep that existing 16-byte bound; reject an oversized package identity early.
(( ${#release} + 3 + 1 <= 16 ))
export KBUILD_BUILD_USER=uke KBUILD_BUILD_HOST=ubuntu-builder KBUILD_BUILD_VERSION=1
export SOURCE_DATE_EPOCH=1793362198
export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH" '+%Y-%m-%d %H:%M:%S UTC')"
case ${1:-} in
 build|boot)
  # One complete producer for normal source packages. Installation never
  # invokes this producer or selects a boot partition.
  receipt=${UKE_HWDB_RECEIPT:-/run/uke-hwdb-provenance}
  [[ -s $receipt/inputs.tsv && -s $receipt/cache.sha256 && -s $receipt/generator.sha256 ]] || {
   echo 'Unsupported: root-prepared signed-host hwdb receipt is required before the trial producer; no build started.' >&2
   exit 78
  }
  for path in "$receipt" "$receipt/inputs.tsv" "$receipt/cache.sha256" "$receipt/generator.sha256"; do
   [[ ! -L $path && $(stat -c %u "$path") == 0 && $((8#$(stat -c %a "$path") & 8#022)) == 0 ]]
  done
  [[ $(dpkg-architecture -qDEB_HOST_ARCH) == arm64 && -d $kernel/native-generated ]]
  [[ ! -e build/boot-recipe-ubuntu && ! -e build/boot-base && ! -e build/boot-output ]]
  bash debian/boot-adapter/stage.sh "$kernel/boot-recipe" build/boot-recipe-ubuntu
  ported=$root/build/boot-recipe-ubuntu
  bash "$ported/src/boot/make-initramfs-base.sh" "$root/build/boot-base" "$release"
  # One producer retains one module key across both Image passes, checks its
  # embedded root-selector note, reads back both wrappers, then deletes the key.
  bash "$ported/src/boot/build-payload.sh" "$kernel" "$root/build/boot-output/ubuntu" "$root/build/boot-base/base" "$release" "${DEB_BUILD_OPTIONS_JOBS:-$(nproc)}"
  [[ ! -e build/boot-output/ubuntu/certs/signing_key.pem ]]
  mkdir build/boot-cohort
  for file in linux.img userdata.img boot-manifest boot-header.json modules.sha256 module-signing.x509; do
   install -m644 "build/boot-output/ubuntu/$file" build/boot-cohort/
  done
  install -m644 build/boot-output/ubuntu/.config build/boot-cohort/config
  install -m644 build/boot-output/ubuntu/arch/arm64/boot/Image build/boot-output/ubuntu/arch/arm64/boot/dts/qcom/sm7675-xiaomi-uke.dtb build/boot-cohort/
  cp -a build/boot-base/licenses build/boot-cohort/licenses
  install -d build/boot-cohort/licenses/linux
  install -m644 "$kernel/LICENSES/preferred/GPL-2.0" "$kernel/LICENSES/preferred/MIT" "$kernel/LICENSES/preferred/BSD-3-Clause" build/boot-cohort/licenses/linux/
  tar -cJf build/boot-cohort/modules.tar.xz -C build/boot-output/ubuntu/boot-modules "lib/modules/$release"
  printf '%s\n' build_only=true publication_authorized=false tablet_actions=false root_image_created=false boot_cohort_admitted=false security_profile_selected=ubuntu-apparmor runtime_enforcement_tested=false > build/boot-cohort/admission
  ;;
 prepare)
  [[ $(dpkg-architecture -qDEB_HOST_ARCH) == arm64 ]]
  [[ ! -e $kernel ]]
  mkdir -p build/keyring
  gpg --batch --dearmor < inputs/linux-stable.asc > build/keyring/linux.gpg
  [[ ! -e inputs/linux-7.3.1.tar.xz ]]
  (cd inputs; sha256sum --check --strict linux-source-parts.sha256)
  [[ $(cat inputs/linux-7.3.1.tar.xz.part-* | sha256sum | cut -d ' ' -f1) == $(jq -er .source_sha256 manifests/linux-7.3.1.json) ]]
  cat inputs/linux-7.3.1.tar.xz.part-* | xz -dc | gpgv --homedir build/keyring --keyring "$root/build/keyring/linux.gpg" inputs/linux-7.3.1.tar.sign -
  cat inputs/linux-7.3.1.tar.xz.part-* | tar -xJf - -C build
  cp -a inputs/senemos-adaptation "$kernel/"
  cp -a inputs/native-profile "$kernel/"
  cp -a inputs/boot-recipe "$kernel/"
  git -C "$kernel" init -q
  while IFS=$'\t' read -r path hash; do
   case $path in patches/*) file=$kernel/senemos-adaptation/patches/${path##*/};; configs/*) file=$kernel/senemos-adaptation/configs/${path##*/};; *) exit 1;; esac
   printf '%s  %s\n' "$hash" "$file" | sha256sum -c -
  done < <(jq -r '.patches[],.configs[]|[.path,.sha256]|@tsv' "$kernel/senemos-adaptation/source-lock.json")
  jq -r '.patches[].path|split("/")|last' "$kernel/senemos-adaptation/source-lock.json" > build/expected-series
  cmp build/expected-series "$kernel/senemos-adaptation/patches/series"
  : > "$kernel/senemos-applied-patches.txt"
  while read -r patch; do
   [[ -n $patch ]]
   git -C "$kernel" apply --check "senemos-adaptation/patches/$patch"
   git -C "$kernel" apply "senemos-adaptation/patches/$patch"
   printf '%s\n' "$patch" >> "$kernel/senemos-applied-patches.txt"
  done < build/expected-series
  cmp build/expected-series "$kernel/senemos-applied-patches.txt"
  # Preserve the shared preparer's tests and generated DT/config inputs.
  bash "$kernel/native-profile/prepare.sh" "$kernel" ;;
 install)
  [[ -d build/boot-cohort && -d build/boot-base && -d build/boot-recipe-ubuntu ]]
  bash debian/boot-trial-tools/stage-kernel-cohort.sh "$root/build/boot-cohort" "$root/build/boot-base" "$root/build/boot-recipe-ubuntu/src/boot/early-modules.list" "$root/build/kernel-packages" source-build
  for role in core dtbs modules boot; do
   package=uke-kernel-$role
   install -d "debian/$package"
   [[ -z $(find "debian/$package" -mindepth 1 -print -quit) ]]
   cp -a "build/kernel-packages/$package/." "debian/$package/"
   install -m644 KERNEL-SOURCE-ORIGIN "debian/$package/usr/share/doc/$package/"
  done
  ;;
 *) echo 'Usage: build-kernel prepare|build|install|boot' >&2; exit 2;;
esac
