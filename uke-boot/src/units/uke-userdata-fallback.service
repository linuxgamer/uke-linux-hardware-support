[Unit]
Description=Return a failed Uke userdata boot trial to its accepted slot
ConditionFirmware=device-tree-compatible(xiaomi,uke)
ConditionKernelCommandLine=root=PARTLABEL=userdata
After=uke-userdata-accept.service

[Service]
Type=oneshot
ExecStart=/usr/bin/uke-kernel-update fallback
TimeoutStartSec=120
UMask=0077
ProtectHome=yes
PrivateTmp=yes
